{
    "name": "biotimeportal/com_biotime",
    "description": "Joomla 6 component: read-only ZKBioTime 9.5 attendance self-service portal (development tooling only; not part of the installable package)",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "psr/log": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "BiotimePortal\\Component\\Biotime\\Administrator\\": "administrator/src/",
            "BiotimePortal\\Component\\Biotime\\Site\\": "site/src/",
            "BiotimePortal\\Component\\Biotime\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit"
    }
}
