<?xml version="1.0" encoding="UTF-8"?>
<!--
    Only permissions live here. Connection and module settings are stored in #__biotime_settings
    through Integration Settings, because com_config replaces all component params on save and the
    database password must be encrypted before it is stored.
-->
<config>
    <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
        <field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules"
               component="com_biotime" section="component" />
    </fieldset>
</config>
