<?xml version="1.0" encoding="UTF-8"?>
<!--
    Integration Settings. Values are validated and stored by SettingsValidator /
    IntegrationsettingsModel (not by com_config); the password and token are encrypted first.
-->
<form>
    <fieldset name="connection" label="COM_BIOTIME_SETTINGS_FIELDSET_CONNECTION">
        <field name="server_url" type="url" label="COM_BIOTIME_SETTINGS_SERVER_URL"
               description="COM_BIOTIME_SETTINGS_SERVER_URL_DESC" hint="https://zkb.example.com:5555"
               required="true" validate="url" scheme="https,http" filter="url" size="60" />
        <field name="connect_via" type="text" label="COM_BIOTIME_SETTINGS_CONNECT_VIA"
               description="COM_BIOTIME_SETTINGS_CONNECT_VIA_DESC" hint="api.zkb.example.com:443" filter="string" size="60" />
        <field name="connect_timeout" type="number" label="COM_BIOTIME_SETTINGS_CONNECT_TIMEOUT"
               description="COM_BIOTIME_SETTINGS_CONNECT_TIMEOUT_DESC" default="5" min="1" max="60" filter="integer" required="true" />
        <field name="timeout" type="number" label="COM_BIOTIME_SETTINGS_TIMEOUT"
               description="COM_BIOTIME_SETTINGS_TIMEOUT_DESC" default="30" min="1" max="300" filter="integer" required="true" />
    </fieldset>

    <fieldset name="credentials" label="COM_BIOTIME_SETTINGS_FIELDSET_CREDENTIALS">
        <field name="auth_method" type="list" label="COM_BIOTIME_SETTINGS_METHOD"
               description="COM_BIOTIME_SETTINGS_METHOD_DESC" default="jwt" validate="options">
            <option value="jwt">COM_BIOTIME_SETTINGS_METHOD_JWT</option>
            <option value="token">COM_BIOTIME_SETTINGS_METHOD_TOKEN</option>
        </field>
        <field name="api_username" type="text" label="COM_BIOTIME_SETTINGS_USERNAME"
               description="COM_BIOTIME_SETTINGS_USERNAME_DESC" autocomplete="off" maxlength="150" filter="string" size="40" />
        <field name="api_password" type="password" label="COM_BIOTIME_SETTINGS_PASSWORD"
               description="COM_BIOTIME_SETTINGS_PASSWORD_DESC" autocomplete="new-password" filter="unset" lock="false" maxlength="256" />
        <field name="clear_password" type="checkbox" label="COM_BIOTIME_SETTINGS_CLEAR_PASSWORD"
               description="COM_BIOTIME_SETTINGS_CLEAR_PASSWORD_DESC" value="1" filter="unset" />
        <field name="api_token" type="password" label="COM_BIOTIME_SETTINGS_TOKEN"
               description="COM_BIOTIME_SETTINGS_TOKEN_DESC" autocomplete="new-password" filter="unset" lock="false"
               showon="auth_method:token" />
        <field name="clear_token" type="checkbox" label="COM_BIOTIME_SETTINGS_CLEAR_TOKEN"
               description="COM_BIOTIME_SETTINGS_CLEAR_TOKEN_DESC" value="1" filter="unset" showon="auth_method:token" />
    </fieldset>

    <fieldset name="tls" label="COM_BIOTIME_SETTINGS_FIELDSET_TLS">
        <field name="verify_tls" type="radio" label="COM_BIOTIME_SETTINGS_VERIFY_TLS"
               description="COM_BIOTIME_SETTINGS_VERIFY_TLS_DESC" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="ca_bundle" type="text" label="COM_BIOTIME_SETTINGS_CA_BUNDLE"
               description="COM_BIOTIME_SETTINGS_CA_BUNDLE_DESC" filter="path" size="60" />
        <field name="tls_pin" type="text" label="COM_BIOTIME_SETTINGS_TLS_PIN"
               description="COM_BIOTIME_SETTINGS_TLS_PIN_DESC" hint="sha256//..." filter="raw" size="60" />
    </fieldset>


    <fieldset name="mapping" label="COM_BIOTIME_SETTINGS_FIELDSET_MAPPING">
        <field name="match_field" type="text" label="COM_BIOTIME_SETTINGS_MATCH_FIELD" description="COM_BIOTIME_SETTINGS_MATCH_FIELD_DESC"
               default="employeeid" hint="employeeid" filter="string" size="30" maxlength="100" />
        <field name="auto_match" type="radio" label="COM_BIOTIME_SETTINGS_AUTO_MATCH" description="COM_BIOTIME_SETTINGS_AUTO_MATCH_DESC"
               layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>

    <fieldset name="modules" label="COM_BIOTIME_SETTINGS_FIELDSET_MODULES">
        <field name="module_charts" type="radio" label="COM_BIOTIME_SETTINGS_MODULE_CHARTS" description="COM_BIOTIME_SETTINGS_MODULE_CHARTS_DESC"
               layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="module_leave" type="radio" label="COM_BIOTIME_SETTINGS_MODULE_LEAVE" description="COM_BIOTIME_SETTINGS_MODULE_LEAVE_DESC"
               layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>

    <fieldset name="daily" label="COM_BIOTIME_SETTINGS_FIELDSET_DAILY">
        <field name="daily_path" type="text" label="COM_BIOTIME_SETTINGS_SOURCE_PATH" description="COM_BIOTIME_SETTINGS_SOURCE_PATH_DESC"
               hint="/…/api/…/" filter="string" size="60" maxlength="200" />
        <field name="daily_param_emp" type="text" label="COM_BIOTIME_SETTINGS_SOURCE_PARAM_EMP" description="COM_BIOTIME_SETTINGS_SOURCE_PARAM_DESC"
               default="emp_code" filter="cmd" size="30" maxlength="40" />
        <field name="daily_param_from" type="text" label="COM_BIOTIME_SETTINGS_SOURCE_PARAM_FROM" description="COM_BIOTIME_SETTINGS_SOURCE_PARAM_DESC"
               default="start_date" filter="cmd" size="30" maxlength="40" />
        <field name="daily_param_to" type="text" label="COM_BIOTIME_SETTINGS_SOURCE_PARAM_TO" description="COM_BIOTIME_SETTINGS_SOURCE_PARAM_DESC"
               default="end_date" filter="cmd" size="30" maxlength="40" />
        <field name="daily_date_format" type="list" label="COM_BIOTIME_SETTINGS_SOURCE_DATE_FORMAT" description="COM_BIOTIME_SETTINGS_SOURCE_DATE_FORMAT_DESC" default="Y-m-d" validate="options">
            <option value="Y-m-d">YYYY-MM-DD</option>
            <option value="Y-m-d H:i:s">YYYY-MM-DD HH:MM:SS</option>
        </field>
        <field name="daily_extra" type="textarea" label="COM_BIOTIME_SETTINGS_SOURCE_EXTRA" description="COM_BIOTIME_SETTINGS_SOURCE_EXTRA_DESC"
               rows="2" filter="raw" hint="key = value" />
        <field name="daily_fields" type="textarea" label="COM_BIOTIME_SETTINGS_SOURCE_FIELDS" description="COM_BIOTIME_SETTINGS_DAILY_FIELDS_DESC"
               rows="8" filter="raw" />
        <field name="daily_duration_unit" type="list" label="COM_BIOTIME_SETTINGS_SOURCE_UNIT" description="COM_BIOTIME_SETTINGS_SOURCE_UNIT_DESC" default="minutes" validate="options">
            <option value="minutes">COM_BIOTIME_SETTINGS_UNIT_MINUTES</option>
            <option value="hours">COM_BIOTIME_SETTINGS_UNIT_HOURS</option>
            <option value="seconds">COM_BIOTIME_SETTINGS_UNIT_SECONDS</option>
        </field>
        <field name="daily_status_map" type="textarea" label="COM_BIOTIME_SETTINGS_SOURCE_STATUS_MAP" description="COM_BIOTIME_SETTINGS_DAILY_STATUS_MAP_DESC"
               rows="6" filter="raw" />
    </fieldset>

    <fieldset name="leave" label="COM_BIOTIME_SETTINGS_FIELDSET_LEAVE">
        <field name="leave_path" type="text" label="COM_BIOTIME_SETTINGS_SOURCE_PATH" description="COM_BIOTIME_SETTINGS_SOURCE_PATH_DESC"
               hint="/…/api/…/" filter="string" size="60" maxlength="200" />
        <field name="leave_param_emp" type="text" label="COM_BIOTIME_SETTINGS_SOURCE_PARAM_EMP" description="COM_BIOTIME_SETTINGS_SOURCE_PARAM_DESC"
               default="emp_code" filter="cmd" size="30" maxlength="40" />
        <field name="leave_param_from" type="text" label="COM_BIOTIME_SETTINGS_SOURCE_PARAM_FROM" description="COM_BIOTIME_SETTINGS_SOURCE_PARAM_DESC"
               default="start_date" filter="cmd" size="30" maxlength="40" />
        <field name="leave_param_to" type="text" label="COM_BIOTIME_SETTINGS_SOURCE_PARAM_TO" description="COM_BIOTIME_SETTINGS_SOURCE_PARAM_DESC"
               default="end_date" filter="cmd" size="30" maxlength="40" />
        <field name="leave_date_format" type="list" label="COM_BIOTIME_SETTINGS_SOURCE_DATE_FORMAT" description="COM_BIOTIME_SETTINGS_SOURCE_DATE_FORMAT_DESC" default="Y-m-d" validate="options">
            <option value="Y-m-d">YYYY-MM-DD</option>
            <option value="Y-m-d H:i:s">YYYY-MM-DD HH:MM:SS</option>
        </field>
        <field name="leave_extra" type="textarea" label="COM_BIOTIME_SETTINGS_SOURCE_EXTRA" description="COM_BIOTIME_SETTINGS_SOURCE_EXTRA_DESC"
               rows="2" filter="raw" hint="key = value" />
        <field name="leave_fields" type="textarea" label="COM_BIOTIME_SETTINGS_SOURCE_FIELDS" description="COM_BIOTIME_SETTINGS_LEAVE_FIELDS_DESC"
               rows="8" filter="raw" />
        <field name="leave_duration_unit" type="list" label="COM_BIOTIME_SETTINGS_SOURCE_UNIT" description="COM_BIOTIME_SETTINGS_SOURCE_UNIT_DESC" default="hours" validate="options">
            <option value="minutes">COM_BIOTIME_SETTINGS_UNIT_MINUTES</option>
            <option value="hours">COM_BIOTIME_SETTINGS_UNIT_HOURS</option>
            <option value="seconds">COM_BIOTIME_SETTINGS_UNIT_SECONDS</option>
        </field>
        <field name="leave_status_map" type="textarea" label="COM_BIOTIME_SETTINGS_SOURCE_STATUS_MAP" description="COM_BIOTIME_SETTINGS_LEAVE_STATUS_MAP_DESC"
               rows="6" filter="raw" />
    </fieldset>

    <fieldset name="system" label="COM_BIOTIME_SETTINGS_FIELDSET_SYSTEM">
        <field name="detailed_log" type="radio" label="COM_BIOTIME_SETTINGS_DETAILED_LOG"
               description="COM_BIOTIME_SETTINGS_DETAILED_LOG_DESC" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="cache_minutes" type="number" label="COM_BIOTIME_SETTINGS_CACHE_MINUTES"
               description="COM_BIOTIME_SETTINGS_CACHE_MINUTES_DESC" default="5" min="0" max="60" filter="integer" required="true" />
        <field name="date_format" type="list" label="COM_BIOTIME_SETTINGS_DATE_FORMAT" description="COM_BIOTIME_SETTINGS_DATE_FORMAT_DESC" default="d/m/Y" validate="options">
            <option value="d/m/Y">05/11/2026</option>
            <option value="Y-m-d">2026-11-05</option>
            <option value="m/d/Y">11/05/2026</option>
            <option value="d.m.Y">05.11.2026</option>
            <option value="d M Y">05 Nov 2026</option>
        </field>
        <field name="time_format" type="list" label="COM_BIOTIME_SETTINGS_TIME_FORMAT" description="COM_BIOTIME_SETTINGS_TIME_FORMAT_DESC" default="H:i" validate="options">
            <option value="H:i">14:05</option>
            <option value="H:i:s">14:05:09</option>
            <option value="h:i A">02:05 PM</option>
        </field>
        <field name="server_timezone" type="timezone" label="COM_BIOTIME_SETTINGS_SERVER_TIMEZONE" description="COM_BIOTIME_SETTINGS_SERVER_TIMEZONE_DESC">
            <option value="">COM_BIOTIME_SETTINGS_TIMEZONE_JOOMLA</option>
        </field>
        <field name="weekend_days" type="checkboxes" label="COM_BIOTIME_SETTINGS_WEEKEND_DAYS" description="COM_BIOTIME_SETTINGS_WEEKEND_DAYS_DESC"
               default="5,6" multiple="true">
            <option value="1">MONDAY</option>
            <option value="2">TUESDAY</option>
            <option value="3">WEDNESDAY</option>
            <option value="4">THURSDAY</option>
            <option value="5">FRIDAY</option>
            <option value="6">SATURDAY</option>
            <option value="7">SUNDAY</option>
        </field>
        <field name="page_size" type="number" label="COM_BIOTIME_SETTINGS_PAGE_SIZE"
               description="COM_BIOTIME_SETTINGS_PAGE_SIZE_DESC" default="100" min="1" max="1000" filter="integer" required="true" />
        <field name="max_pages" type="number" label="COM_BIOTIME_SETTINGS_MAX_PAGES"
               description="COM_BIOTIME_SETTINGS_MAX_PAGES_DESC" default="50" min="1" max="1000" filter="integer" required="true" />
    </fieldset>
</form>
