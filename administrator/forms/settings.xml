<?xml version="1.0" encoding="UTF-8"?>
<!--
    Integration Settings. Values are validated and stored by SettingsValidator /
    IntegrationsettingsModel (not by com_config); the database password is encrypted first.
-->
<form>
    <fieldset name="mapping" label="COM_BIOTIME_SETTINGS_FIELDSET_MAPPING">
        <field name="match_field" type="text" label="COM_BIOTIME_SETTINGS_MATCH_FIELD" description="COM_BIOTIME_SETTINGS_MATCH_FIELD_DESC"
               default="employeeid" hint="employeeid" filter="string" size="30" maxlength="100" />
        <field name="auto_match" type="radio" label="COM_BIOTIME_SETTINGS_AUTO_MATCH" description="COM_BIOTIME_SETTINGS_AUTO_MATCH_DESC"
               layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>

    <fieldset name="report" label="COM_BIOTIME_SETTINGS_FIELDSET_REPORT">
        <field name="report_logo" type="media" label="COM_BIOTIME_SETTINGS_REPORT_LOGO" description="COM_BIOTIME_SETTINGS_REPORT_LOGO_DESC"
               types="images" preview="tooltip" />
        <field name="report_header_left" type="text" label="COM_BIOTIME_SETTINGS_REPORT_HEADER_LEFT" description="COM_BIOTIME_SETTINGS_REPORT_HEADER_LEFT_DESC"
               filter="string" size="50" maxlength="200" />
        <field name="report_header_right" type="text" label="COM_BIOTIME_SETTINGS_REPORT_HEADER_RIGHT" description="COM_BIOTIME_SETTINGS_REPORT_HEADER_RIGHT_DESC"
               filter="string" size="50" maxlength="200" />
        <field name="report_footer" type="textarea" label="COM_BIOTIME_SETTINGS_REPORT_FOOTER" description="COM_BIOTIME_SETTINGS_REPORT_FOOTER_DESC"
               filter="string" rows="4" cols="60" />
        <field name="report_color" type="color" label="COM_BIOTIME_SETTINGS_REPORT_COLOR" description="COM_BIOTIME_SETTINGS_REPORT_COLOR_DESC"
               default="#1d3f74" />
    </fieldset>

    <fieldset name="database" label="COM_BIOTIME_SETTINGS_FIELDSET_DATABASE">
        <field name="db_engine" type="list" label="COM_BIOTIME_SETTINGS_DB_ENGINE" description="COM_BIOTIME_SETTINGS_DB_ENGINE_DESC" default="" validate="options">
            <option value="">COM_BIOTIME_SETTINGS_DB_ENGINE_OFF</option>
            <option value="pgsql">PostgreSQL</option>
            <option value="sqlsrv">Microsoft SQL Server</option>
        </field>
        <field name="db_server" type="text" label="COM_BIOTIME_SETTINGS_DB_SERVER" description="COM_BIOTIME_SETTINGS_DB_SERVER_DESC"
               hint="zkb-server.example.local:7496" filter="string" size="50" maxlength="300" showon="db_engine!:" />
        <field name="db_connect_via" type="text" label="COM_BIOTIME_SETTINGS_DB_VIA" description="COM_BIOTIME_SETTINGS_DB_VIA_DESC"
               hint="203.0.113.10:7496" filter="string" size="30" maxlength="60" showon="db_engine:pgsql" />
        <field name="db_name" type="text" label="COM_BIOTIME_SETTINGS_DB_NAME" description="COM_BIOTIME_SETTINGS_DB_NAME_DESC"
               default="biotime" filter="string" size="30" maxlength="63" showon="db_engine!:" />
        <field name="db_user" type="text" label="COM_BIOTIME_SETTINGS_DB_USER" description="COM_BIOTIME_SETTINGS_DB_USER_DESC"
               hint="joomla_portal" autocomplete="off" filter="string" size="30" maxlength="63" showon="db_engine!:" />
        <field name="db_password" type="password" label="COM_BIOTIME_SETTINGS_DB_PASSWORD" description="COM_BIOTIME_SETTINGS_DB_PASSWORD_DESC"
               autocomplete="new-password" filter="unset" lock="false" maxlength="256" showon="db_engine!:" />
        <field name="clear_db_password" type="checkbox" label="COM_BIOTIME_SETTINGS_CLEAR_DB_PASSWORD" description="COM_BIOTIME_SETTINGS_CLEAR_DB_PASSWORD_DESC"
               value="1" filter="unset" showon="db_engine!:" />
        <field name="db_ssl" type="list" label="COM_BIOTIME_SETTINGS_DB_SSL" description="COM_BIOTIME_SETTINGS_DB_SSL_DESC" default="verify" validate="options" showon="db_engine!:">
            <option value="verify">COM_BIOTIME_SETTINGS_DB_SSL_VERIFY</option>
            <option value="require">COM_BIOTIME_SETTINGS_DB_SSL_REQUIRE</option>
            <option value="off">COM_BIOTIME_SETTINGS_DB_SSL_OFF</option>
        </field>
        <field name="db_ca" type="text" label="COM_BIOTIME_SETTINGS_DB_CA" description="COM_BIOTIME_SETTINGS_DB_CA_DESC"
               filter="path" size="60" showon="db_engine!:[AND]db_ssl!:off" />
        <field name="db_duration_unit" type="list" label="COM_BIOTIME_SETTINGS_DB_UNIT" description="COM_BIOTIME_SETTINGS_DB_UNIT_DESC" default="auto" validate="options" showon="db_engine:pgsql">
            <option value="auto">COM_BIOTIME_SETTINGS_DB_UNIT_AUTO</option>
            <option value="minutes">COM_BIOTIME_SETTINGS_UNIT_MINUTES</option>
            <option value="seconds">COM_BIOTIME_SETTINGS_UNIT_SECONDS</option>
        </field>
        <field name="connect_timeout" type="number" label="COM_BIOTIME_SETTINGS_CONNECT_TIMEOUT"
               description="COM_BIOTIME_SETTINGS_CONNECT_TIMEOUT_DESC" default="5" min="1" max="60" filter="integer" required="true" />
        <field name="timeout" type="number" label="COM_BIOTIME_SETTINGS_TIMEOUT"
               description="COM_BIOTIME_SETTINGS_TIMEOUT_DESC" default="30" min="1" max="300" filter="integer" required="true" />
    </fieldset>

    <fieldset name="system" label="COM_BIOTIME_SETTINGS_FIELDSET_SYSTEM">
        <field name="detailed_log" type="radio" label="COM_BIOTIME_SETTINGS_DETAILED_LOG"
               description="COM_BIOTIME_SETTINGS_DETAILED_LOG_DESC" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="cache_minutes" type="number" label="COM_BIOTIME_SETTINGS_CACHE_MINUTES"
               description="COM_BIOTIME_SETTINGS_CACHE_MINUTES_DESC" default="5" min="0" max="60" filter="integer" required="true" />
        <field name="date_format" type="list" label="COM_BIOTIME_SETTINGS_DATE_FORMAT" description="COM_BIOTIME_SETTINGS_DATE_FORMAT_DESC" default="d/m/Y" validate="options">
            <option value="d/m/Y">05/11/2026</option>
            <option value="Y-m-d">2026-11-05</option>
            <option value="m/d/Y">11/05/2026</option>
            <option value="d.m.Y">05.11.2026</option>
            <option value="d M Y">05 Nov 2026</option>
        </field>
        <field name="time_format" type="list" label="COM_BIOTIME_SETTINGS_TIME_FORMAT" description="COM_BIOTIME_SETTINGS_TIME_FORMAT_DESC" default="H:i" validate="options">
            <option value="H:i">14:05</option>
            <option value="H:i:s">14:05:09</option>
            <option value="h:i A">02:05 PM</option>
        </field>
        <field name="server_timezone" type="timezone" label="COM_BIOTIME_SETTINGS_SERVER_TIMEZONE" description="COM_BIOTIME_SETTINGS_SERVER_TIMEZONE_DESC">
            <option value="">COM_BIOTIME_SETTINGS_TIMEZONE_JOOMLA</option>
        </field>
        <field name="weekend_days" type="checkboxes" label="COM_BIOTIME_SETTINGS_WEEKEND_DAYS" description="COM_BIOTIME_SETTINGS_WEEKEND_DAYS_DESC"
               default="5,6" multiple="true">
            <option value="1">MONDAY</option>
            <option value="2">TUESDAY</option>
            <option value="3">WEDNESDAY</option>
            <option value="4">THURSDAY</option>
            <option value="5">FRIDAY</option>
            <option value="6">SATURDAY</option>
            <option value="7">SUNDAY</option>
        </field>
    </fieldset>
</form>
